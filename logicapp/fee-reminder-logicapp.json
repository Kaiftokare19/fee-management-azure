{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Recurrence": {
                "recurrence": {
                    "interval": 1,
                    "frequency": "Day",
                    "timeZone": "India Standard Time",
                    "schedule": {
                        "hours": [
                            9
                        ],
                        "minutes": [
                            0
                        ]
                    }
                },
                "evaluatedRecurrence": {
                    "interval": 1,
                    "frequency": "Day",
                    "timeZone": "India Standard Time",
                    "schedule": {
                        "hours": [
                            9
                        ],
                        "minutes": [
                            0
                        ]
                    }
                },
                "type": "Recurrence"
            }
        },
        "actions": {
            "Execute_a_SQL_query_(V2)": {
                "runAfter": {},
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['sql']['connectionId']"
                        }
                    },
                    "method": "post",
                    "body": {
                        "query": "SELECT StudentID, Name, Email, Course, Balance, DueDate, DaysOverdue FROM dbo.vw_OverdueStudents;"
                    },
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))},@{encodeURIComponent(encodeURIComponent('default'))}/query/sql",
                    "retryPolicy": {
                        "type": "exponential",
                        "count": 4,
                        "interval": "PT10S",
                        "minimumInterval": "PT5S",
                        "maximumInterval": "PT1H"
                    }
                }
            },
            "For_each": {
                "foreach": "@body('Execute_a_SQL_query_(V2)')?['resultsets']?['Table1']",
                "actions": {
                    "Send_an_email_(V2)": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['outlook']['connectionId']"
                                }
                            },
                            "method": "post",
                            "body": {
                                "To": "@items('For_each')?['Email']",
                                "Subject": "@concat('Fee reminder: Rs ', string(items('For_each')?['Balance']), ' overdue')",
                                "Body": "<p class=\"editor-paragraph\">@{concat('Dear ', items('For_each')?['Name'], ', your fee balance of Rs ', string(items('For_each')?['Balance']), ' for ', items('For_each')?['Course'], ' was due on ', items('For_each')?['DueDate'], ' (', string(items('For_each')?['DaysOverdue']), ' days ago). Please pay at the earliest.')}</p>",
                                "Importance": "Normal"
                            },
                            "path": "/v2/Mail",
                            "retryPolicy": {
                                "type": "exponential",
                                "count": 4,
                                "interval": "PT10S",
                                "minimumInterval": "PT5S",
                                "maximumInterval": "PT1H"
                            }
                        }
                    }
                },
                "runAfter": {
                    "Execute_a_SQL_query_(V2)": [
                        "Succeeded"
                    ]
                },
                "type": "Foreach"
            }
        },
        "outputs": {},
        "parameters": {
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {
                "sql": {
                    "id": "/subscriptions/f57d3088-8e24-48c3-b0d0-00c721a39408/providers/Microsoft.Web/locations/centralindia/managedApis/sql",
                    "connectionId": "/subscriptions/f57d3088-8e24-48c3-b0d0-00c721a39408/resourceGroups/rg-feemgmt-demo/providers/Microsoft.Web/connections/sql",
                    "connectionName": "sql",
                    "connectionProperties": {}
                },
                "outlook": {
                    "id": "/subscriptions/f57d3088-8e24-48c3-b0d0-00c721a39408/providers/Microsoft.Web/locations/centralindia/managedApis/outlook",
                    "connectionId": "/subscriptions/f57d3088-8e24-48c3-b0d0-00c721a39408/resourceGroups/rg-feemgmt-demo/providers/Microsoft.Web/connections/outlook",
                    "connectionName": "outlook",
                    "connectionProperties": {}
                }
            }
        }
    }
}